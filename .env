# Environment variables for docker-compose and the app
# CHANGE THE SECRET_KEY to a long random value in production
SECRET_KEY=YOUR_SUPER_SECRET_KEY_CHANGE_THIS

# Postgres credentials
POSTGRES_USER=chess_user
POSTGRES_PASSWORD=chess_password
POSTGRES_DB=chess_db

# Database URL used by the backend
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Frontend will use this to reach the backend from the host browser
VITE_API_URL=http://localhost:8000
